# Keep the Docker build context to just the sources the image needs.
# Everything here is excluded from `docker build`.
# Build artifacts and VCS
target
.git
.gitignore
.gitattributes
.github
.githooks

# Docs and tests: not needed inside the image
docs
tests
examples
*.md
LICENSE

# Dev-only inputs the prod image doesn't need
benches
demo
dev
tools
docker-compose*.yml
assets/brand

# Agent scratch trees
.crush
.playwright
.playwright-mcp
.superpowers
.serena
.claude
.scratch
.worktrees

# Local tooling configs
bacon.toml
deny.toml
mise.toml
rust-toolchain.toml
rustfmt.toml
_typos.toml
taplo.toml

# Secrets, defense in depth
.env
.env.*
