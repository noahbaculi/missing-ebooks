#!/bin/sh
# Pre-commit guard: run the same fmt, clippy, and type checks as the CI jobs in
# .github/workflows/ci.yml, so those failures surface here instead of after a
# push. mise.toml's `[hooks] enter` entry auto-activates this hook on the first
# `cd` into the worktree (ADR-0026); `mise run setup` is the manual fallback.
#
# The checks read the working tree, not a staged-only snapshot. Building a
# staged-only view means stashing unstaged changes, which is risky for little
# gain when commits stage everything they touch. Bypass in a pinch with
# `git commit --no-verify`; agents must not, per CLAUDE.md.
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Each language's checks run only when a staged file could change their result,
# so unrelated commits (docs, or the other language) stay fast.
rust_changed=$(printf '%s\n' "$staged" | grep -Eq '(\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)(rust-toolchain|rustfmt|\.rustfmt|clippy)\.toml$)' && echo 1 || true)
js_changed=$(printf '%s\n' "$staged" | grep -Eq '((^|/)assets/app\.js$|(^|/)assets/prepaint\.js$|\.d\.ts$|(^|/)tsconfig\.json$)' && echo 1 || true)
accent_changed=$(printf '%s\n' "$staged" | grep -Eq '((^|/)assets/app\.(css|js)$|(^|/)assets/prepaint\.js$|(^|/)tests/accent/)' && echo 1 || true)
toml_changed=$(printf '%s\n' "$staged" | grep -Eq '\.toml$' && echo 1 || true)

if [ -n "$rust_changed" ]; then
  if ! cargo fmt --check; then
    echo "pre-commit: 'cargo fmt --check' failed. Run 'cargo fmt', then re-stage and commit." >&2
    exit 1
  fi
  if ! cargo clippy --locked --all-targets; then
    echo "pre-commit: 'cargo clippy' failed. Fix the warnings above, then re-stage and commit." >&2
    exit 1
  fi
  if ! RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --quiet; then
    echo "pre-commit: 'cargo doc -D warnings' failed. Fix the rustdoc warnings above, then re-stage and commit." >&2
    exit 1
  fi
  if ! cargo machete; then
    echo "pre-commit: 'cargo machete' found unused dependencies. Remove them from Cargo.toml, then re-stage and commit." >&2
    exit 1
  fi
fi

if [ -n "$js_changed" ]; then
  if ! mise run typecheck; then
    echo "pre-commit: 'mise run typecheck' failed. Fix the type errors above, then re-stage and commit." >&2
    exit 1
  fi
fi

if [ -n "$accent_changed" ]; then
  if ! mise run test:accent; then
    echo "pre-commit: 'mise run test:accent' failed. Fix the accent derivation above, then re-stage and commit." >&2
    exit 1
  fi
fi

if [ -n "$toml_changed" ]; then
  if ! taplo format --check; then
    echo "pre-commit: 'taplo format --check' failed. Run 'taplo format' to fix, then re-stage and commit." >&2
    exit 1
  fi
fi

if ! typos; then
  echo "pre-commit: 'typos' found spelling issues above. Fix them (or extend the typos allow-list), then re-stage and commit." >&2
  exit 1
fi
